# Copy to `.env` (locally: apps/server/.env; on the host: <app-root>/.env, chmod 600).
# Variables already present in the environment (e.g. NODE_ENV from the hosting panel) win.

# development | production | test (on the host it is set by the panel's "Tryb aplikacji")
NODE_ENV=development

# Local only: Passenger overrides listen() on the host.
PORT=3000
HOST=127.0.0.1

LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# Quote values with special characters: an unquoted `#` starts a comment.
DB_PASSWORD=''
DB_NAME=rekordy_sportowe

# Local only: database used by integration tests. It is WIPED by the tests.
# Without it the DB integration tests are skipped.
TEST_DB_NAME=rekordy_sportowe_test

# Paths relative to the application root (working directory)
# WEB_DIR=dist/web
# MIGRATIONS_DIR=drizzle
# STORAGE_DIR=storage
