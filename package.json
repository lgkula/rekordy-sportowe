{
  "name": "rekordy-sportowe",
  "version": "0.1.0",
  "private": true,
  "description": "Personal sports records web app (running, trail running).",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm run dev -w @rekordy/server\" \"npm run dev -w @rekordy/web\"",
    "build": "npm run build -w @rekordy/web && npm run build -w @rekordy/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate -w @rekordy/server",
    "db:migrate": "npm run db:migrate -w @rekordy/server",
    "package": "node scripts/package.mjs",
    "deploy": "node scripts/deploy.mjs",
    "spike:build": "node spikes/passenger-hello/build.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
